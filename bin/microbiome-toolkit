#!/usr/bin/env bash
# ============================================================================
# microbiome-toolkit — unified entry point for the Microbiome-SOP-Toolkit.
#
# Two standardized workflows are provided (each with a plain-run mode and a
# PBS-cluster submission mode):
#
#   16s        - QIIME2-based 16S rRNA amplicon analysis
#                (import -> primer trim -> DADA2 -> taxonomy -> phylogeny
#                 -> microeco export)
#   metagenome - shotgun metagenomics analysis
#                (QC/dehost -> MEGAHIT assembly -> gene catalog -> quant
#                 -> taxonomy -> function -> MAG binning -> MAG annotation)
#
# Usage:
#   microbiome-toolkit <workflow> [options]         run a workflow
#   microbiome-toolkit <workflow> --submit [opts]   generate a PBS script and qsub it
#   microbiome-toolkit init-config [workflow]       copy example YAML config(s)
#   microbiome-toolkit list                         list workflows & entry points
#   microbiome-toolkit --help / -h                  this help
#   microbiome-toolkit --version                    version
#
# Every workflow accepts `--config FILE.yaml` in addition to plain CLI flags
# (CLI flags override config-file values).  See docs/PARAMETERS.md.
#
# Cluster flags (with --submit): --pbs-nodes N, --pbs-mem MEM,
# --walltime HH:MM:SS, --dry-run (print command/PBS, do not run).
#
# Examples:
#   microbiome-toolkit 16s --config config/16s_config.yaml
#   microbiome-toolkit 16s --input data/fastq --region 16S_V4 \
#       --classifier /db/silva.qza --output results/ --threads 16
#   microbiome-toolkit 16s --input data/fastq --region 16S_V4 \
#       --classifier /db/silva.qza --submit
#   microbiome-toolkit metagenome --config config/metagenome_config.yaml
#   microbiome-toolkit metagenome --input data/reads \
#       --host-genome /db/host_db/wheat/wheat --submit
#
# Backward-compatible aliases: `qiime2-sop` == `microbiome-toolkit 16s`,
# `mg-sop` == `microbiome-toolkit metagenome` (see bin/qiime2-sop, bin/mg-sop).
# The plain drivers bin/run_16s.sh / bin/run_metagenome.sh are for scripting
# and `--config`-only use.
#
# The script is symlink-safe: it resolves its own real location so the
# workflow directory is always found even when invoked through a symlink in
# ~/bin or /usr/local/bin.
# ============================================================================
set -euo pipefail

VERSION="1.0.1"
TOOLKIT_NAME="Microbiome-SOP-Toolkit"

# ---- resolve real location (follow symlink chain) ---------------------------
_SRC="${BASH_SOURCE[0]}"
while [[ -L "${_SRC}" ]]; do
  _TGT="$(readlink "${_SRC}")"
  if [[ "${_TGT}" == /* ]]; then _SRC="${_TGT}"
  else _SRC="$(cd "$(dirname "${_SRC}")" && pwd)/${_TGT}"; fi
done
SCRIPT_DIR="$(cd "$(dirname "${_SRC}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

usage() {
  sed -n '2,45p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

cmd="${1:-}"
shift || true

case "${cmd}" in
  -h|--help|"")
    usage
    exit 0
    ;;
  --version)
    echo "${TOOLKIT_NAME} ${VERSION}"
    exit 0
    ;;
  list)
    echo "${TOOLKIT_NAME} ${VERSION}"
    echo
    echo "Workflows (unified CLI):"
    echo "  microbiome-toolkit 16s [--submit] ...         QIIME2 amplicon pipeline"
    echo "  microbiome-toolkit metagenome [--submit] ...  shotgun metagenomics pipeline"
    echo
    echo "Entry points in ${ROOT_DIR}/bin:"
    echo "  microbiome-toolkit   unified CLI (this dispatcher)"
    echo "  qiime2-sop           alias of 'microbiome-toolkit 16s' (kept for compatibility)"
    echo "  mg-sop               alias of 'microbiome-toolkit metagenome' (kept for compatibility)"
    echo "  run_16s.sh           plain 16S driver (no default output dir, no --submit)"
    echo "  run_metagenome.sh    plain metagenome driver (no --submit)"
    exit 0
    ;;
  init-config)
    wf="${1:-}"
    dst="${2:-.}"
    mkdir -p "${dst}"
    case "${wf}" in
      16s|"")
        cp "${ROOT_DIR}/config/16s_config.example.yaml" "${dst}/16s_config.yaml"
        echo "Wrote ${dst}/16s_config.yaml (edit paths, then: microbiome-toolkit 16s --config ${dst}/16s_config.yaml)"
        ;;
      metagenome)
        cp "${ROOT_DIR}/config/metagenome_config.example.yaml" "${dst}/metagenome_config.yaml"
        echo "Wrote ${dst}/metagenome_config.yaml (edit paths, then: microbiome-toolkit metagenome --config ${dst}/metagenome_config.yaml)"
        ;;
      *)
        echo "ERROR: init-config expects [16s|metagenome], got: ${wf}" >&2
        exit 1
        ;;
    esac
    exit 0
    ;;
  # The wrapper scripts handle both plain runs (default output dir, personal
  # config) and PBS submission (--submit), so the unified CLI delegates to
  # them; qiime2-sop / mg-sop are simply backward-compatible names for the
  # same entry points.
  16s)
    exec bash "${SCRIPT_DIR}/qiime2-sop" "$@"
    ;;
  metagenome)
    exec bash "${SCRIPT_DIR}/mg-sop" "$@"
    ;;
  *)
    echo "ERROR: unknown command: ${cmd} (try: microbiome-toolkit --help)" >&2
    exit 1
    ;;
esac
